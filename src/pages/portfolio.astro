---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Portfolio"
  description="A selection of timeless, elegant interiors by Soraya Rose Studio across London, the Home Counties and beyond.">
  <section class="mx-auto max-w-4xl px-6 pb-14 pt-20 text-center lg:pb-20 lg:pt-28">
    <p class="eyebrow text-taupe">Portfolio</p>
    <h1 class="mt-5 font-display text-5xl font-light leading-[1.05] lg:text-7xl">Our <em>work</em></h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink/70">A selection of timeless, elegant interiors across London, the Home Counties and beyond.</p>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
    <!-- To add more photos, copy a <figure> block and point it at the next image, e.g. images/portfolio-13.jpg -->
    <div class="gap-6 sm:columns-2 lg:columns-3">
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[4/5] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-01.jpg')" role="img" aria-label="A living room with a marble coffee table, bouclé chairs and a lit fireplace"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[4/3] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-02.jpg')" role="img" aria-label="A kitchen with a marble splashback, timber island and brass pendant lights"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-square transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-03.jpg')" role="img" aria-label="A bedroom with an upholstered headboard and burgundy cushions"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[3/4] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-04.jpg')" role="img" aria-label="A bathroom with a dark marble vanity and freestanding stone bath"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[4/3] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-05.jpg')" role="img" aria-label="A games room with a snooker table and sage-green panelling"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[4/5] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-06.jpg')" role="img" aria-label="A children’s bedroom with built-in bunk beds"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[4/5] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-07.jpg')" role="img" aria-label="An entrance hall with a round stone table and garden doors"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[4/3] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-08.jpg')" role="img" aria-label="A dressing room lined with lit walnut joinery"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-square transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-09.jpg')" role="img" aria-label="A living room with a green velvet sofa and marble coffee table"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[3/4] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-10.jpg')" role="img" aria-label="A panelled snug with a fireplace and bookshelves, seen through a doorway"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[4/3] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-11.jpg')" role="img" aria-label="A home cinema with velvet sofas and lit shelving"></div>
      </figure>
      <figure class="mb-6 break-inside-avoid overflow-hidden">
        <div class="photo aspect-[4/5] transition duration-700 hover:scale-105" style="--img:url('/images/portfolio-12.jpg')" role="img" aria-label="A dressing room with a marble-topped island"></div>
      </figure>
    </div>
  </section>
</BaseLayout>
