---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact"
  description="Get in touch with Soraya Rose Studio, Kingshead House, 15 London End, Beaconsfield, Bucks HP9 2HN."
  showCta={false}>
  <section class="mx-auto max-w-4xl px-6 pb-14 pt-20 text-center lg:pb-20 lg:pt-28">
    <p class="eyebrow text-taupe">Contact</p>
    <h1 class="mt-5 font-display text-5xl font-light leading-[1.05] lg:text-7xl">Begin your <em>project</em></h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink/70">Whether you are planning a complete home transformation, an extensive renovation or a single room, we would love to hear from you.</p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24 lg:px-10 lg:pb-32">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="flex flex-col justify-center space-y-12">
        <div>
          <p class="eyebrow text-taupe">Email</p>
          <a href="mailto:hello@sorayarosestudio.co.uk" class="mt-3 block break-words font-display text-3xl font-light hover:text-espresso lg:text-4xl">hello@sorayarosestudio.co.uk</a>
        </div>
        <div>
          <p class="eyebrow text-taupe">Studio</p>
          <address class="mt-3 font-display text-2xl font-light not-italic leading-snug">Kingshead House<br>15 London End<br>Beaconsfield, Bucks<br>United Kingdom, HP9 2HN</address>
        </div>
        <div>
          <p class="eyebrow text-taupe">Where we work</p>
          <p class="mt-3 leading-relaxed text-ink/75">Predominantly across London and the Home Counties, with select projects further afield and internationally.</p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="mailto:hello@sorayarosestudio.co.uk?subject=New%20project%20enquiry" class="btn">Email us <span aria-hidden="true">&rarr;</span></a>
          <a href="https://www.google.com/maps/search/?api=1&amp;query=Kingshead+House,+15+London+End,+Beaconsfield+HP9+2HN" class="link-arrow self-center" target="_blank" rel="noopener">Get directions <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="photo aspect-[4/5]" style="--img:url('/images/contact.jpg')" role="img" aria-label="A welcoming interior by Soraya Rose Studio"></div>
    </div>
  </section>
</BaseLayout>
